	(text "U42 SN74AXC4T774, 1.8 V (B) <-> 3.3 V (A):\nCh1 DIR1 low = B->A: HPS UART0 TX out\nCh2 DIR2 high = A->B: UART0 RX in\nCh3: eth_rst_n -> phy_rst_n (PHY reset)\nCh4 DIR4 low: pg_all (1.8 V) -> pg_all_3v3 -> LED D1"
		(exclude_from_sim no)
		(at 69.85 99.06 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "056e1f1d-00e5-408e-9e58-68c5f0731af9")
	)
	(text "J10: 1 = TX (3.3 V out), 2 = RX (3.3 V\nin).\nGND on J2.3 / J4"

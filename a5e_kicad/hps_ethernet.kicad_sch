	(text "PWR_FLAG: PHY3V3 behind FB1"
		(exclude_from_sim no)
		(at 109.22 48.26 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "9afefcd9-4dc7-4216-82e7-00ae79999287")
	)
	(text "FB1: AVDD33 (pins 11, 40) filtered from 3V3. PHY1V0 = LDO_OUT (pin 30) -> AVDD10/DVDD10 only."
		(exclude_from_sim no)
		(at 35.56 40.64 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "d0f5cae5-cdb3-4d97-a74f-2b0b93c9b377")
	)
	(text "Optional at these lengths (<20 mm) - fit 0R if not wanted."
		(exclude_from_sim no)
		(at 35.56 147.5 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "de61bbad-0473-4911-9b80-812971707f09")
	)
	(text "RGMII delay: set over MDIO (page 0xd08); with Linux phy-mode = \"rgmii-id\" the PHY adds 2 ns on TX and RX."
		(exclude_from_sim no)
		(at 35.56 150 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "e3f017c0-efaf-4533-b34a-3eb5457ca9d6")
	)
	(text "Config straps (data sheet 7.8: external pulls required), 4K7: PHYAD[2:0]=001 (R32 up / R33, R31 down),\nPLLOFF=0 (R269 down), TXDLY=0 (R270 down), RXDLY=1 (R39 up) - RX straps to PHY_RG;\nCFG_EXT=0 (R271 down on LED0), CFG_LDO=10 (R35 down on LED1, R268 up to 3V3 on LED2). R34/R37 DNP (wrong direction)."
		(exclude_from_sim no)
		(at 25.4 194.31 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "e41a9d40-7f85-463c-a9e7-cb1692a3aa98")
	)
	(text "RESET: R247 10k pull-down + C259 1u on eth_rst_n (HPS GPIO1_IO18, K71, 1.8 V) -> U42 ch3 -> phy_rst_n (3.3 V) -> PHYRSTB.\nPHY held in reset until software drives the GPIO high; hold low >= 10 ms, wait >= 50 ms before MDIO access."
		(exclude_from_sim no)
		(at 27.686 160.02 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "e6727ed0-16b0-4481-9a26-dd389278b25f")
	)

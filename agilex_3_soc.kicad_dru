(version 1)

# LPDDR4 breakout: 0.1 mm neck-down is allowed only inside the Agilex (U7) and LPDDR4 (U12) courtyards.
# Outside them the net classes give the 50 ohm widths (0.15 mm on F/B.Cu, 0.12 mm on inner layers)
# and the 100 ohm pair geometry (0.13/0.25 mm outer, 0.11/0.25 mm inner) from the tuning profiles.
(rule "lpddr_bga_neckdown"
	(condition "(A.NetClass == 'lpddr_dq' || A.NetClass == 'lpddr_ca' || A.NetClass == 'lpddr_diff') && (A.insideCourtyard('U7') || A.insideCourtyard('U12'))")
	(constraint track_width (min 0.09mm) (opt 0.1mm))
	(constraint diff_pair_gap (min 0.09mm) (opt 0.2mm)))

# DQS / CK pairs: intra-pair skew and allowed uncoupled escape length
(rule "lpddr_pair_skew"
	(condition "A.NetClass == 'lpddr_diff'")
	(constraint skew (max 2ps) (within_diff_pairs)))
(rule "lpddr_pair_uncoupled"
	(condition "A.NetClass == 'lpddr_diff'")
	(constraint diff_pair_uncoupled (max 5mm)))

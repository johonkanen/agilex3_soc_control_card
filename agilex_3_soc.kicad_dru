(version 1)

# ===================================================================================================
# LPDDR4 rules (net classes lpddr_dq, lpddr_ca, lpddr_diff).  KiCad applies the LAST matching rule,
# so the general rules come first and the BGA-courtyard exceptions (U7 Agilex, U12 LPDDR4) after them.
# intersectsCourtyard() also catches segments that cross the courtyard edge (insideCourtyard() would not).
# Altera PCB Design Guidelines 821801, 6.3.2.2 (Agilex 5 E-Series Group B), Tables 8-10, recommend a
#   40 ohm stripline / 45 ohm microstrip main segment, no differential target for CLK/DQS ("keep traces
#   closely coupled", 4 mil in-pair spacing), spacing 2h within a group, 3h between groups (CMD/CLK to
#   DQ/DQS, nibble to nibble, serpentines, RESET), P/N skew < 1 ps.
# Widths: 0.10 mm everywhere instead (2026-10-28), from the IBIS simulation in sim/lpddr4_si (40-150 ohm
#   lines, 1600 and 2133 MT/s, typ/min/max: margins move by only ~10-15 ps from 40 to 70 ohm). Stack-up
#   JLC08161H-3313, field-solved (tools/kicad_ibis_simulation, zsolve.py): 0.10 mm = 54-55 ohm on In2/In5,
#   59 ohm on F/B; pairs 0.10 / 0.10 mm gap = 44 ohm odd mode, 87-88 ohm differential. 0.09 mm (JLC
#   minimum) only for local squeezes. h ~ 0.1 mm on F.Cu/In2/In5, so 2h = 0.2 mm and 3h = 0.3 mm.
#   Route LPDDR4 on In2 (over In1 GND) first, In5 only inside one In6 pour, edge escapes on F.Cu; not on
#   In3/In6 (see LPDDR4_SWIZZLE_PLAN.md).
# JLCPCB minimum trace/space is 0.09 mm; the 0.075 mm clearance used between the 0.4 mm U7 pads is below
# that - see the note at the end.
# ===================================================================================================

# ---- DQ/DM/CA and DQS/CK pairs: 0.10 mm on every layer, pairs with a 0.10 mm gap ------------------
(rule "lpddr_width"
	(condition "A.hasNetclass('lpddr_dq') || A.hasNetclass('lpddr_ca') || A.hasNetclass('lpddr_diff')")
	(constraint track_width (min 0.09mm) (opt 0.1mm) (max 0.11mm)))
(rule "lpddr_diff_gap"
	(condition "A.hasNetclass('lpddr_diff')")
	(constraint diff_pair_gap (min 0.1mm) (opt 0.1mm) (max 0.15mm)))

# ---- pair integrity (whole net, all layers) --------------------------------------------------------
# P/N skew < 1 ps (Table 10), and the total length the two halves may run apart: escape through the U7
# ball field (~6 mm), the U12 escape through its 0.65 mm channels (~8 mm) and the pad entries.
(rule "lpddr_pair_skew"
	(condition "A.hasNetclass('lpddr_diff')")
	(constraint skew (max 1ps) (within_diff_pairs)))
(rule "lpddr_pair_uncoupled"
	(condition "A.hasNetclass('lpddr_diff')")
	(constraint diff_pair_uncoupled (max 12mm)))

# ---- byte groups: DQ/DM of one byte within 10 ps (KiCad delay = copper + U7 pad die_delay) ----------
# KiCad keeps only the last matching skew rule per net and the pair rule needs both halves, so the DQS
# pairs stay out of these groups (they keep the 1 ps pair rule). DQS is tied to its byte by the per-net
# delay windows at the end (same target for DQ, DM and DQS).
# Altera allows DQ-DQS -68 ... +43 ps incl. the FPGA package; 10 ps keeps every byte near the centre.
# CA/CK cannot be a skew rule (KiCad's totals of the T-nets include both branches); they get per-net
# windows from tools/lpddr4_delay/delay_report.py --dru (block at the end), which also checks die -> ball.
(rule "lpddr_byte0_skew"
	(condition "A.NetName == '/IOBANK 3/dq0' || A.NetName == '/IOBANK 3/dq1' || A.NetName == '/IOBANK 3/dq2' || A.NetName == '/IOBANK 3/dq3' || A.NetName == '/IOBANK 3/dq4' || A.NetName == '/IOBANK 3/dq5' || A.NetName == '/IOBANK 3/dq6' || A.NetName == '/IOBANK 3/dq7' || A.NetName == '/IOBANK 3/dm0'")
	(constraint skew (max 10ps)))
(rule "lpddr_byte1_skew"
	(condition "A.NetName == '/IOBANK 3/dq8' || A.NetName == '/IOBANK 3/dq9' || A.NetName == '/IOBANK 3/dq10' || A.NetName == '/IOBANK 3/dq11' || A.NetName == '/IOBANK 3/dq12' || A.NetName == '/IOBANK 3/dq13' || A.NetName == '/IOBANK 3/dq14' || A.NetName == '/IOBANK 3/dq15' || A.NetName == '/IOBANK 3/dm1'")
	(constraint skew (max 10ps)))
(rule "lpddr_byte2_skew"
	(condition "A.NetName == '/IOBANK 3/dq16' || A.NetName == '/IOBANK 3/dq17' || A.NetName == '/IOBANK 3/dq18' || A.NetName == '/IOBANK 3/dq19' || A.NetName == '/IOBANK 3/dq20' || A.NetName == '/IOBANK 3/dq21' || A.NetName == '/IOBANK 3/dq22' || A.NetName == '/IOBANK 3/dq23' || A.NetName == '/IOBANK 3/dm2'")
	(constraint skew (max 10ps)))
(rule "lpddr_byte3_skew"
	(condition "A.NetName == '/IOBANK 3/dq24' || A.NetName == '/IOBANK 3/dq25' || A.NetName == '/IOBANK 3/dq26' || A.NetName == '/IOBANK 3/dq27' || A.NetName == '/IOBANK 3/dq28' || A.NetName == '/IOBANK 3/dq29' || A.NetName == '/IOBANK 3/dq30' || A.NetName == '/IOBANK 3/dq31' || A.NetName == '/IOBANK 3/dm3'")
	(constraint skew (max 10ps)))

# ---- crosstalk spacing outside the BGAs (warnings) -------------------------------------------------
# 2h within a group, 3h between groups.  Byte-to-byte (nibble) 3h is not expressible per byte with the
# current net classes: keep 0.3 mm between bytes by hand.
(rule "lpddr_xtalk_spacing"
	(severity warning)
	(condition "A.Type == 'Track' && B.Type == 'Track' && (A.hasNetclass('lpddr_dq') || A.hasNetclass('lpddr_ca') || A.hasNetclass('lpddr_diff')) && (B.hasNetclass('lpddr_dq') || B.hasNetclass('lpddr_ca') || B.hasNetclass('lpddr_diff')) && A.NetName != B.NetName && !A.inDiffPair('*') && !(A.intersectsCourtyard('U7') || A.intersectsCourtyard('U12'))")
	(constraint clearance (min 0.2mm)))
(rule "lpddr_xtalk_group"
	(severity warning)
	(condition "A.Type == 'Track' && B.Type == 'Track' && ((A.hasNetclass('lpddr_ca') && (B.hasNetclass('lpddr_dq') || B.NetName == '/IOBANK 3/dqs0_P' || B.NetName == '/IOBANK 3/dqs0_N' || B.NetName == '/IOBANK 3/dqs1_P' || B.NetName == '/IOBANK 3/dqs1_N' || B.NetName == '/IOBANK 3/dqs2_P' || B.NetName == '/IOBANK 3/dqs2_N' || B.NetName == '/IOBANK 3/dqs3_P' || B.NetName == '/IOBANK 3/dqs3_N')) || A.NetName == '/IOBANK 3/~{rst}') && A.NetName != B.NetName && !(A.intersectsCourtyard('U7') || A.intersectsCourtyard('U12'))")
	(constraint clearance (min 0.3mm)))

# ---- LPDDR4 routing layers (LPDDR4_SWIZZLE_PLAN.md "Layer rules") -------------------------------------
# Tracks only on F.Cu, In2, In5 and B.Cu: In1/In4 are GND planes, In3 (~73 ohm, no adjacent plane) and In6
# (power islands) are not for LPDDR4.  Vias are not affected.  "In5 only inside one In6 pour" cannot be
# expressed here (rules can test rule areas, not copper pours): check it by eye.
(rule "lpddr_layers"
	(condition "A.Type == 'Track' && (A.hasNetclass('lpddr_dq') || A.hasNetclass('lpddr_ca') || A.hasNetclass('lpddr_diff')) && (A.Layer == 'In1.Cu' || A.Layer == 'In3.Cu' || A.Layer == 'In4.Cu' || A.Layer == 'In6.Cu')")
	(constraint disallow track))

# ---- inside the BGA courtyards: single-channel escape --------------------------------------------
# One 0.1 mm trace per channel between the balls (the same width as outside, so no neck-down).  A pair may split into two channels here, so the
# gap has no real upper limit (5 mm; without a max KiCad applies 0.15 mm); it is counted as uncoupled
# length by the rule above. The CA/CK T-branches under U12 rely on this.
(rule "lpddr_bga_neckdown"
	(condition "(A.hasNetclass('lpddr_dq') || A.hasNetclass('lpddr_ca') || A.hasNetclass('lpddr_diff')) && (A.intersectsCourtyard('U7') || A.intersectsCourtyard('U12'))")
	(constraint track_width (min 0.09mm) (opt 0.1mm) (max 0.11mm))
	(constraint diff_pair_gap (min 0.1mm) (opt 0.2mm) (max 5mm)))

# Clearance between LPDDR tracks and the U7 pads / via-in-pad vias: the 0.4 mm pads on 0.65 mm pitch
# leave 0.25 mm, i.e. 0.1 mm trace + 2 x 0.075 mm.  This matches the 0.075 mm pad overrides already on
# the footprint and the board minimum clearance, but it is BELOW JLCPCB's 0.09 mm capability.  To be
# within spec, reduce the U7 pads to 0.35 mm (0.3 mm channel -> 0.1 mm trace + 2 x 0.1 mm) and raise
# this rule and the board minimum to 0.09 mm.
(rule "lpddr_bga_clearance"
	(condition "(A.hasNetclass('lpddr_dq') || A.hasNetclass('lpddr_ca') || A.hasNetclass('lpddr_diff')) && A.Type == 'Track' && (B.Type == 'Pad' || B.Type == 'Via') && A.intersectsCourtyard('U7')")
	(constraint clearance (min 0.075mm)))
(rule "lpddr_bga_clearance_u12"
	(condition "(A.hasNetclass('lpddr_dq') || A.hasNetclass('lpddr_ca') || A.hasNetclass('lpddr_diff')) && A.Type == 'Track' && (B.Type == 'Pad' || B.Type == 'Via') && A.intersectsCourtyard('U12')")
	(constraint clearance (min 0.1mm)))

# ===================================================================================================
# JLCPCB multilayer capabilities (jlcpcb.com/capabilities/pcb-capabilities, checked 2026-10-13).
# Board setup constraints carry the rest: clearance/track 0.09, via 0.25/0.15 (annular 0.05, 0.075
# preferred - the 0.3/0.15 vias used here), via hole-to-hole 0.2, silk 1.0 mm / 0.15 mm.
# Via-in-pad on U7 relies on JLCPCB epoxy filled & capped vias (default for 6+ layers; select it
# when ordering).
#
# Hole clearance is set to 0.175 mm (= 0.075 mm via ring + 0.1 mm copper clearance). JLCPCB lists
# "via hole to track 0.2 mm" without saying whether it is measured from the drill or the ring; at
# 0.2 mm about 200 existing track/via spots would fail. Confirm with the JLCPCB DFM check on the
# Gerbers before raising it.
# ===================================================================================================
(rule "jlc_pth_annular"
	(condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'")
	(constraint annular_width (min 0.15mm)))
(rule "jlc_pad_hole_to_hole"
	(condition "A.Type == 'Pad' && B.Type == 'Pad' && A.Pad_Type == 'Through-hole' && B.Pad_Type == 'Through-hole'")
	(constraint hole_to_hole (min 0.45mm)))
(rule "jlc_pth_to_track"
	(condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole' && B.Type != 'Pad'")
	(constraint hole_clearance (min 0.28mm)))

# ---- BEGIN delay_report targets (generated by tools/lpddr4_delay/delay_report.py --dru; do not edit) ----
# Lengthen-only targets: each byte tuned to its slowest net (floor: CK - 170 ps + window), CA/CKE/CS/CK to the
# slowest CA/CK die->ball delay
# (KiCad totals: die_delay + copper; T-nets include both branches). Rerun the script after re-routing.
